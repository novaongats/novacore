rules_version = '2';

// ============================================================
// NOVA Core v2 — Cloud Storage セキュリティルール
//
// 適用方法: Firebase Console → Storage → ルール に全文貼付して「公開」
// （書類管理・レシートスキャンの原本アップロードが対象）
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
